                    : isActive ? 'bg-[#E53935] text-white shadow-md shadow-red-200 ring-4 ring-red-100'
                    : 'bg-zinc-100 text-zinc-400'}`}
                >
                  {isDone ? <Check size={16} strokeWidth={3} /> : i + 1}

              <a href={`tel:${phone}`} className="hover:text-white transition-colors">
                📞 {phone}
              </a>
            )}
          </motion.div>
        )}

        {description && (
          <motion.p
            className="mt-4 text-zinc-400 text-sm leading-relaxed max-w-xl"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 0.4 }}
          >
            {description}
          </motion.p>
        )}
      </div>
    </div>
  )
}
